<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ShopEase - Online Shopping</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #f7f7f7;
            color: #222;
        }

        /* =========================
           NAVBAR
        ========================= */

        nav {
            background: #111827;
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 27px;
            font-weight: bold;
        }

        .logo span {
            color: #ff6b35;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        nav ul li a:hover {
            color: #ff6b35;
        }

        .cart-button {
            background: #ff6b35;
            color: white;
            padding: 10px 16px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        .cart-button:hover {
            background: #ff8558;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 70vh;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.55),
                    rgba(0, 0, 0, 0.55)
                ),
                url("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=80");

            background-size: cover;
            background-position: center;

            color: white;

            padding: 40px 20px;
        }

        .hero-content {
            max-width: 700px;
        }

        .hero h1 {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 25px;
        }

        .shop-btn {
            display: inline-block;

            background: #ff6b35;
            color: white;

            padding: 14px 28px;

            border-radius: 25px;

            text-decoration: none;

            font-weight: bold;

            transition: 0.3s;
        }

        .shop-btn:hover {
            background: #ff8558;
            transform: translateY(-2px);
        }

        /* =========================
           SECTION
        ========================= */

        section {
            padding: 65px 7%;
        }

        .section-title {
            text-align: center;
            font-size: 35px;
            margin-bottom: 35px;
        }

        /* =========================
           SEARCH
        ========================= */

        .search-box {
            display: flex;
            justify-content: center;
            margin-bottom: 25px;
        }

        .search-box input {
            width: 400px;

            padding: 14px 20px;

            border: 1px solid #ddd;

            border-radius: 25px;

            outline: none;

            font-size: 16px;

            transition: 0.3s;
        }

        .search-box input:focus {
            border-color: #ff6b35;
            box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.12);
        }

        /* =========================
           CATEGORY
        ========================= */

        .categories {
            text-align: center;
            margin-bottom: 30px;
        }

        .category-btn {
            border: none;

            background: #e5e7eb;

            padding: 10px 20px;

            margin: 5px;

            border-radius: 20px;

            cursor: pointer;

            transition: 0.3s;
        }

        .category-btn:hover,
        .category-btn.active {
            background: #111827;
            color: white;
        }

        /* =========================
           PRODUCTS
        ========================= */

        .products {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(230px, 1fr));

            gap: 25px;
        }

        .product-card {
            background: white;

            border-radius: 12px;

            overflow: hidden;

            box-shadow:
                0 5px 20px rgba(0, 0, 0, 0.08);

            transition: 0.3s;
        }

        .product-card:hover {
            transform: translateY(-7px);

            box-shadow:
                0 12px 30px rgba(0, 0, 0, 0.13);
        }

        .product-card img {
            width: 100%;
            height: 230px;

            object-fit: cover;

            display: block;
        }

        .product-info {
            padding: 18px;
        }

        .product-info h3 {
            margin-bottom: 8px;
        }

        .product-info p {
            color: #777;

            font-size: 14px;

            margin-bottom: 12px;

            min-height: 34px;
        }

        .price {
            font-size: 20px;

            font-weight: bold;

            color: #ff6b35;
        }

        .add-btn {
            float: right;

            border: none;

            background: #111827;

            color: white;

            padding: 9px 14px;

            border-radius: 20px;

            cursor: pointer;

            transition: 0.3s;
        }

        .add-btn:hover {
            background: #ff6b35;
        }

        /* =========================
           CART
        ========================= */

        .cart-overlay {
            position: fixed;

            top: 0;
            left: 0;

            width: 100%;
            height: 100%;

            background: rgba(0, 0, 0, 0.45);

            z-index: 1500;

            opacity: 0;
            visibility: hidden;

            transition: 0.3s;
        }

        .cart-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .cart-box {
            position: fixed;

            top: 0;
            right: -420px;

            width: 380px;
            max-width: 90%;

            height: 100%;

            background: white;

            box-shadow:
                -5px 0 20px rgba(0, 0, 0, 0.2);

            z-index: 2000;

            padding: 25px;

            transition: 0.4s;

            overflow-y: auto;
        }

        .cart-box.open {
            right: 0;
        }

        .close-cart {
            float: right;

            font-size: 28px;

            cursor: pointer;

            color: #333;

            transition: 0.2s;
        }

        .close-cart:hover {
            color: #ff6b35;
        }

        .cart-box h2 {
            margin-bottom: 25px;
        }

        .cart-item {
            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 10px;

            border-bottom: 1px solid #ddd;

            padding: 15px 0;
        }

        .cart-item-info {
            flex: 1;
        }

        .cart-item-price {
            color: #777;
            font-size: 14px;
            margin-top: 4px;
        }

        .quantity {
            display: flex;

            align-items: center;

            gap: 8px;
        }

        .quantity button {
            border: none;

            background: #111827;

            color: white;

            width: 25px;
            height: 25px;

            border-radius: 50%;

            cursor: pointer;
        }

        .quantity button:hover {
            background: #ff6b35;
        }

        .remove-btn {
            border: none;

            background: #dc2626;

            color: white;

            padding: 5px 8px;

            border-radius: 5px;

            cursor: pointer;
        }

        .remove-btn:hover {
            background: #b91c1c;
        }

        .cart-total {
            font-size: 22px;

            font-weight: bold;

            margin: 25px 0;
        }

        .checkout {
            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 25px;

            background: #ff6b35;

            color: white;

            font-size: 16px;

            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        .checkout:hover {
            background: #e85a28;
        }

        /* =========================
           EMPTY SEARCH MESSAGE
        ========================= */

        .no-products {
            grid-column: 1 / -1;

            text-align: center;

            padding: 40px;

            color: #777;

            font-size: 18px;
        }

        /* =========================
           FEATURES
        ========================= */

        .features {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(200px, 1fr));

            gap: 20px;

            text-align: center;
        }

        .feature {
            background: white;

            padding: 30px 20px;

            border-radius: 12px;

            box-shadow:
                0 5px 20px rgba(0, 0, 0, 0.05);

            transition: 0.3s;
        }

        .feature:hover {
            transform: translateY(-5px);
        }

        .feature h3 {
            margin: 12px 0;
        }

        .feature p {
            color: #777;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #111827;

            color: white;

            text-align: center;

            padding: 25px;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            nav {
                padding: 15px 5%;
            }

            nav ul {
                display: none;
            }

            .hero {
                min-height: 65vh;
            }

            .hero h1 {
                font-size: 40px;
            }

            .hero p {
                font-size: 17px;
            }

            .cart-box {
                width: 90%;
            }

            .search-box input {
                width: 90%;
            }

            section {
                padding: 50px 5%;
            }

            .section-title {
                font-size: 30px;
            }

            .cart-item {
                flex-wrap: wrap;
            }

        }

    </style>
</head>


